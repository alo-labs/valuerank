{"claim_id": "bad209b144e05edd", "section_id": "copilot", "text": "A GitHub Copilot commenter with plan not stated reported 24,000 of 150,000 monthly AI credits used during project migration; a separate author with plan not stated said two generations used their monthly allowance plus nearly USD $8.", "claim_type": "factual", "cited_source_ids": ["8ad8e0e78344258f", "ad72b6c538e04535", "1c7dce35515bbd80"], "evidence_ids": ["d27c8bda066e1677", "a5cc222a5e359753", "3d74655fe6720bdd"], "support_status": "partial", "extracted_at": "2026-10-05T00:00:00Z", "_support_score": 0.566, "_support_notes": "entity mismatch"}
