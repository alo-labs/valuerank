{"post_stream":{"posts":[{"id":983977,"name":"MoonPostman","username":"MoonPostman","avatar_template":"/letter_avatar_proxy/v4/letter/m/e19b73/{size}.png","created_at":"2026-10-25T17:28:16.059Z","cooked":"\u003cp\u003e\u003cimg src=\"https://oss.locdd.com/2026/10/26/1792949294790.png\" alt=\"image\" width=\"690\" height=\"198\"\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://oss.locdd.com/2026/10/26/1792949294973.png\" alt=\"image\" width=\"690\" height=\"264\"\u003e\u003cbr\u003e\n97% 的缓存命中率，外推周额度大概 6.6 亿 token 的 k3.1，以前用 k3 是周额度 5 亿不到的样子，可能确实是降价了？\u003c/p\u003e\n\u003cp\u003e相比之下，我这边 claude 20 刀套餐周额度能有 8 亿的 opus5.5\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":6,"updated_at":"2026-10-25T17:28:16.059Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":1,"readers_count":0,"score":0.2,"yours":false,"topic_id":103774,"topic_slug":"topic","display_username":"MoonPostman","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":54,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/topic/103774/1","locale":null,"is_localized":false,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":984089,"name":"ForestElf","username":"ForestElf","avatar_template":"/letter_avatar_proxy/v4/letter/f/c68b51/{size}.png","created_at":"2026-10-26T00:19:11.694Z","cooked":"\u003cp\u003e之前冲过一次就感觉kimi用起来比Claude还贵，后来就没再续费，这下看来虽有小涨，但还是不如