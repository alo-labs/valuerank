{"post_stream":{"posts":[{"id":985365,"name":"SunnyDoll","username":"SunnyDoll","avatar_template":"/letter_avatar_proxy/v4/letter/s/e274bd/{size}.png","created_at":"2026-10-26T06:24:24.076Z","cooked":"\u003cp\u003e老套餐199，claude desktop使用，纯3.1pro。\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://oss.locdd.com/2026/10/26/1792995863061.png\" alt=\"image\" width=\"690\" height=\"370\"\u003e\u003c/p\u003e\n\u003cp\u003e这是用完一个5H的用量，周限是5个5H，3.1pro应该是等价400元的额度。\u003c/p\u003e\n\u003cp\u003e之前用k3的时候我体验下来是类似550~600的额度的，也许有大佬有实测证据实锤一下更好\u003c/p\u003e\n\u003cp\u003eapi价格下降了还以为套餐用量会更多了，现在看要么k3一个价要么就是还涨价了 \u003cimg src=\"https://www.locdd.com/images/emoji/twitter/sweat_smile.png?v=15\" title=\":sweat_smile:\" class=\"emoji\" alt=\":sweat_smile:\" loading=\"lazy\" width=\"20\" height=\"20\"\u003e\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":10,"updated_at":"2026-10-26T06:24:24.076Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":103915,"topic_slug":"topic","display_username":"SunnyDoll","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":44,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/topic/103915/1","locale":null,"is_localized":false,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":985386,"name":"TimeMachine","username":"TimeMachine","avatar_template":"/letter_avatar_proxy/v4/letter/t/57b2e6/{size}.png","created_at":"2026-10-26T06:30:00.544Z","cooked":"\u003cp\u003e已经有不少实测哦：\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp\u003e订阅中缓存读取价格极低，不能直接套用 API 定价推算\u003cbr\u003e\n否则统计金额会随着缓存命中率大幅波动\u003cbr\u003e\n参考上面这位大佬的方法进行了校准，结果如下：\u003cbr\u003e\nAllegretto（¥199），K3.1 Pro\u003cbr\u003e\n计费项\u003cbr\u003e\n5h 权重 (M⁻¹)\u003cbr\u003e\n7d 权重 (M⁻¹)\u003cbr\u003e\n相对 Allegro\u003cbr\u003e\n输入\u003cbr\u003e\n0.2810 [0.2808, 0.2811]\u003cbr\u003e\n0.0562\u003cbr\u003e\n3.00×\u003cbr\u003e\n读缓\u003cbr\u003e\n0.001407 [0.001372, 0.001425]\u003cbr\u003e\n0.000281\u003cbr\u003e\n2.98×\u003cbr\u003e\n输出\u003cbr\u003e\n2.247…\u003c/p\u003e\n\u003c/blockquote\u003e","post_number":2,"post_type":1,"posts_count":10,"updated_at":"2026-10-26T06:30:00.544Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":103915,"topic_slug":"topic","display_username":"TimeMachine","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":37,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/topic/103915/2","locale":null,"is_localized":false,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":985387,"name":"BrightestStar","username":"BrightestStar","avatar_template":"/letter_avatar_proxy/v4/letter/b/f07891/{size}.png","created_at":"2026-10-26T06:30:06.390Z","cooked":"\u003cp\u003e钱